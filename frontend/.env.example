# Copy to frontend/.env.local. NEXT_PUBLIC_* values are inlined at BUILD time and are public:
# never put a secret here (the Supabase anon/publishable key is designed to be public).
NEXT_PUBLIC_API_URL=http://localhost:8000

# "demo" (local only; the backend must also run AUTH_MODE=demo) or "supabase".
NEXT_PUBLIC_AUTH_MODE=demo
# Required when NEXT_PUBLIC_AUTH_MODE=supabase:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key>
