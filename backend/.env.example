# Copy to backend/.env for local development. Never commit the real .env.
# All values below are placeholders.

APP_ENV=development
APP_NAME=commerceops-api
DEBUG=false

# SQLAlchemy/psycopg URL. postgres:// and postgresql:// are also accepted and
# normalised to postgresql+psycopg:// automatically.
# Local (docker compose): matches the POSTGRES_* values in the root .env.example
DATABASE_URL=postgresql+psycopg://commerceops:change-me@localhost:5432/commerceops
# Supabase (later): use the connection string from the Supabase dashboard, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Tests only: a DEDICATED database whose name ends in _test (the suite downgrades it).
# TEST_DATABASE_URL=postgresql+psycopg://commerceops:change-me@localhost:5432/commerceops_test

# Comma-separated list of allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM provider: "ollama" (local, free) or "gemini" (hosted demo).
LLM_PROVIDER=ollama
# Per-request timeout in seconds (1-300).
LLM_TIMEOUT_SECONDS=60
# Retries apply only to transient timeouts/unavailability (0-2).
LLM_MAX_RETRIES=1

# Local Ollama:  ollama pull llama3.2:3b  &&  ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Gemini (hosted demo). Leave empty unless you use Gemini; never commit a real key.
# Only synthetic/demo data may be sent to the Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# External LLM tracing (LangSmith) is opt-in and OFF. LangSmith reads this from the process
# environment (export it / set it on the host); it is not loaded from this file by the app.
LANGSMITH_TRACING=false
