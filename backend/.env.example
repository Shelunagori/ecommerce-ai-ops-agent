# Copy to backend/.env for local development. Never commit the real .env.
# All values below are placeholders.

APP_ENV=development
APP_NAME=commerceops-api
DEBUG=false

# SQLAlchemy/psycopg URL. postgres:// and postgresql:// are also accepted and
# normalised to postgresql+psycopg:// automatically.
# Local (docker compose): matches the POSTGRES_* values in the root .env.example
DATABASE_URL=postgresql+psycopg://commerceops:change-me@localhost:5432/commerceops
# Supabase (later): use the connection string from the Supabase dashboard, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Tests only: a DEDICATED database whose name ends in _test (the suite downgrades it).
# TEST_DATABASE_URL=postgresql+psycopg://commerceops:change-me@localhost:5432/commerceops_test

# Comma-separated list of allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM provider: "ollama" (local, free) or "gemini" (hosted demo).
LLM_PROVIDER=ollama
# Per-request timeout in seconds (1-300).
LLM_TIMEOUT_SECONDS=60
# Retries apply only to transient timeouts/unavailability (0-2).
LLM_MAX_RETRIES=1

# Local Ollama:  ollama pull qwen3:4b-instruct  &&  ollama serve
# qwen3:4b-instruct = Qwen3-4B-Instruct-2507, a non-thinking instruct/tool-use model.
# Other models work too, e.g. OLLAMA_MODEL=llama3.2:3b. Note: qwen3:4b is the
# thinking variant (alias of qwen3:4b-thinking) and may put reasoning text in answers.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Gemini (hosted demo). Leave empty unless you use Gemini; never commit a real key.
# Only synthetic/demo data may be sent to the Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Commerce assistant tool-calling loop bounds (hard maxima: 10 / 20 / 8).
ASSISTANT_MAX_MODEL_ROUNDS=5
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_MAX_TOOL_CALLS_PER_TURN=4

# Embeddings (policy RAG): "ollama" (local) or "gemini" (hosted, uses GEMINI_API_KEY).
# Each provider/model/dimension is a separate embedding profile; re-run embed_policies after
# switching. Changing EMBEDDING_DIMENSIONS requires a new profile, never an in-place change.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Approval-gated actions (cancel_order, issue_store_credit on a SYNTHETIC ledger).
ACTION_APPROVAL_TTL_SECONDS=900
ACTION_EXECUTION_CLAIM_TIMEOUT_SECONDS=120
STORE_CREDIT_MAX_AMOUNT=100.00

# Authentication / tenant boundary.
#   demo     - trusts the X-Tenant-ID header (LOCAL DEMO ONLY; refused when APP_ENV=production)
#   supabase - Supabase Auth JWT (verified via the project's JWKS) + tenant_memberships table
AUTH_MODE=demo
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# Legacy HS256 projects only (asymmetric JWKS keys are preferred). Never commit a real value.
# SUPABASE_JWT_SECRET=
DEMO_USER_SUBJECT=demo-user

# External LLM tracing (LangSmith) is opt-in and OFF. When on, prompts and model outputs are
# sent to LangSmith - synthetic data only. Never commit a real key.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=commerceops-ai

# Production (APP_ENV=production) refuses to start unless: DATABASE_URL set, DEBUG=false,
# AUTH_MODE=supabase with an https SUPABASE_URL, explicit https CORS_ORIGINS, LLM_PROVIDER and
# EMBEDDING_PROVIDER = gemini with GEMINI_API_KEY. Check with: python -m scripts.check_env
