# Copy to backend/.env for local development. Never commit the real .env.
# All values below are placeholders.

APP_ENV=development
APP_NAME=commerceops-api
DEBUG=false

# SQLAlchemy/psycopg URL. postgres:// and postgresql:// are also accepted and
# normalised to postgresql+psycopg:// automatically.
# Local (docker compose): matches the POSTGRES_* values in the root .env.example
DATABASE_URL=postgresql+psycopg://commerceops:change-me@localhost:5432/commerceops
# Supabase (later): use the connection string from the Supabase dashboard, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM settings - not used yet (reserved for a later step).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
